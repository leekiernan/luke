{
  "name": "perci",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "perci": "dist/index.js"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "swc src -d dist --copy-files --strip-leading-paths",
    "build:watch": "swc src -d dist --watch --copy-files --strip-leading-paths",
    "clean": "rm -rf dist",
    "import": "npm run build && node dist/index.js import",
    "lookup": "npm run build && node dist/index.js lookup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
